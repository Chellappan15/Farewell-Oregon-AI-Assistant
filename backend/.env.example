# Copy to backend/.env and fill in real values. Never commit .env.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

DB_HOST=localhost
DB_PORT=3306
DB_USER=gaming_ai_app
DATABASE_PASSWORD=
DB_NAME=llm
DB_POOL_SIZE=5
# Only set to true for local development without SSL.
DB_SSL_DISABLED=false

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_COLLECTION=days_gone
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_DISTANCE=1.2

CORS_ORIGINS=http://localhost:5173
